{
  // Cloudflare Workers with Static Assets
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadslab-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Production settings
  "vars": {
    "MODEL": "claude-haiku-5-5",
    "ALLOWED_ORIGINS": "https://kadslab.com,https://www.kadslab.com"
  },
  // Staging preview settings
  "previews": {
    "vars": {
      "MODEL": "claude-haiku-5-5",
      "ALLOWED_ORIGINS": "https://staging-kadslab-site.dawoodali-1071.workers.dev"
    }
  }
  // Secret (never committed): ANTHROPIC_API_KEY
}