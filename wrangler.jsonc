{
  // Cloudflare Workers with Static Assets. Static pages are served straight
  // from ./dist; only /api/* runs the Worker (worker/index.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadslab-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Production settings (kadslab.com). ALLOWED_ORIGINS is an exact list of
  // origins whose pages may call /api/ask; nothing else is accepted.
  "vars": {
    "MODEL": "claude-haiku-5-5",
    "ALLOWED_ORIGINS": "https://kadslab.com,https://www.kadslab.com"
  },
  // Staging preview settings (the staging branch's workers.dev preview URL).
  // Cloudflare adds "X-Robots-Tag: noindex" to preview URLs itself, so
  // staging stays out of search results; production never gets that header.
  "previews": {
    "vars": {
      "MODEL": "claude-haiku-5-5",
      "ALLOWED_ORIGINS": "https://staging-kadslab-site.dawoodali-1071.workers.dev"
    }
  }
  // Optional secret (never committed): ANTHROPIC_API_KEY. Without it, Digital
  // Dawood answers from src/data/knowledge.ts at no cost. Before adding it,
  // create a Cloudflare WAF rate-limiting rule for /api/ask (see worker/index.ts).
}
