---
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DigitalTwin from '../components/DigitalTwin';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  bodyClass?: string;
}
const { title, description, path, bodyClass } = Astro.props;
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.owner} · Digital solutions, Chicago` : `${title} — ${SITE.name}`;
const canonical = new URL(path, Astro.site).toString();
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.owner,
  jobTitle: 'Digital Solutions Consultant & Engineer',
  url: 'https://kadslab.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  sameAs: [SITE.linkedin, SITE.github],
};
---
<!doctype html>
<html lang="en">
  <head>
<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-856M3YJC6R"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-856M3YJC6R');
</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#F7F5F0" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DigitalTwin client:idle transition:persist="digital-dawood" />
  </body>
</html>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  document.addEventListener('astro:before-swap', (event) => {
    const { newDocument } = event as TransitionBeforeSwapEvent;
    if (!newDocument.body.classList.contains('lab-page')) return;

    let theme = 'dark';
    try { if (localStorage.getItem('kads-lab-theme') === 'light') theme = 'light'; } catch {}
    newDocument.documentElement.dataset.labTheme = theme;
    newDocument.querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#11131A' : '#F7F5F0');
  });
</script>
