---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid';
import ShowcaseGallery from '../components/ShowcaseGallery';
import { TILES } from '../data/site';
---
<Base title="Work" path="/work/" description="Industry case studies from Dawood Ali Khan: listings engines, CRM lead routing, media platforms, multi-location SEO and content systems. Client details stay under NDA.">
  <section class="wrap" style="padding-block: 88px 40px">
    <span class="eyebrow">Work · 11 live sites · {TILES.length} case studies</span>
    <h1 class="h-display" style="margin-top: 16px; max-width: 1100px">The problems are real. <span class="accent">The names stay private.</span></h1>
    <p class="lead" style="margin-top: 24px">Live sites I built or worked on at three agencies, then deeper case studies told through original concepts. Client names stay private; the work and my role are real.</p>
  </section>
  <section class="wrap" style="padding-bottom: 104px">
    <span class="eyebrow">Live work · 2019 — 2026</span>
    <h2 class="h-section" style="margin-top: 12px">Shipped and live on the web.</h2>
    <p class="lead" style="margin-top: 14px">Real sites from three agencies. Click a screen for what I did. Client names stay private.</p>
    <ShowcaseGallery client:visible />
  </section>
  <section class="wrap rule-top" style="padding-block: 104px 120px">
    <span class="eyebrow">Case studies · industry concepts</span>
    <h2 class="h-section" style="margin: 12px 0 32px">How I solved specific problems.</h2>
    <WorkGrid client:visible />
  </section>
  <section class="dark">
    <div class="wrap" style="padding-block: 88px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 32px">
      <h2 class="h-section" style="max-width: 760px">Want the full story behind a project? Ask me in an interview.</h2>
      <a class="btn btn-orange" href="/contact/">Start a conversation →</a>
    </div>
  </section>
</Base>
