---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404/" description="This page doesn't exist on KADS Lab.">
  <section class="wrap" style="padding-block: 140px">
    <span class="eyebrow">404</span>
    <h1 class="h-display" style="margin-top: 16px">This route isn’t wired up. <span class="accent">Yet.</span></h1>
    <p class="lead" style="margin-top: 24px">The page you’re looking for doesn’t exist. Try the work or the lab instead.</p>
    <div style="margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap"><a class="btn btn-dark" href="/">Home</a><a class="btn btn-ghost" href="/work/">See the work</a></div>
  </section>
</Base>
