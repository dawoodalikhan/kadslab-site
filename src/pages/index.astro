---
import Base from '../layouts/Base.astro';
import HeroDesk from '../components/HeroDesk';
import KadsHero from '../components/KadsHero';
import LeadRouting from '../components/LeadRouting';
import ShowcaseGallery from '../components/ShowcaseGallery';
import { RANGE, SITE } from '../data/site';

---
<Base title="Home" path="/" description="KADS Lab is the portfolio of Dawood Ali Khan, a Chicago digital solutions consultant and engineer who scopes, architects and builds web platforms, integrations and automation.">

  <section class="hero">
    <div class="wrap row">
      <div style="flex: 1 1 520px; min-width: 0">
        <KadsHero client:load />
        <h1>Business problems in.<br /><span class="accent">Working systems</span> out.</h1>
        <p class="lead">I scope, architect and build the platforms, integrations and automations behind real businesses, and I lead the delivery from first call to launch.</p>
        <div style="margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px">
          <a class="btn btn-dark" href="/work/">See the work</a>
          <a class="btn btn-ghost" href="/lab/">Try a live demo</a>
        </div>
      </div>
      <div style="flex: 1 1 520px; min-width: 0">
        <HeroDesk client:load />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap">
      <dl>
        <div><dt>Years building</dt><dd>7+</dd></div>
        <div><dt>Sites shipped</dt><dd>30+</dd></div>
        <div><dt>Developers led</dt><dd>5+</dd></div>
        <div><dt>Based in</dt><dd>Chicago</dd></div>
      </dl>
    </div>
  </section>

  <section class="dark section">
    <div class="wrap">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="h-section" style="margin-top: 12px">Shipped, live, and still running.</h2>
        </div>
        <a href="/work/" style="font-weight: 600">All work →</a>
      </div>
      <div style="margin-top: 56px">
        <ShowcaseGallery client:visible limit={3} dark />
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="row" style="align-items: flex-start; gap: 40px">
      <div class="side">
        <span class="eyebrow">Lab · live demo</span>
        <h2 class="h-section" style="margin-top: 12px; font-size: clamp(34px, 4vw, 56px)">Send a test inquiry. Watch where it goes.</h2>
        <p style="margin-top: 18px; color: var(--ink-2)">Pick an inquiry type and the route, owner and follow-up change, the way a real CRM workflow would.</p>
        <a href="/lab/" style="display: inline-block; margin-top: 12px; font-weight: 600">Open the Lab: 5 demos →</a>
      </div>
      <div class="grow">
        <LeadRouting client:visible />
      </div>
    </div>
  </section>

  <section class="bp-grid rule-top rule-bottom">
    <div class="wrap row" style="padding-block: 96px; align-items: flex-end">
      <div class="grow">
        <span class="eyebrow" style="color: var(--ink-2)">§ Engineering — the code side</span>
        <h2 style="margin: 18px 0 0; font-size: clamp(38px, 5vw, 76px); line-height: .98; letter-spacing: -.035em; font-weight: 700">From DC motors to data clusters <span class="accent">to the web.</span></h2>
      </div>
      <div class="side" style="display: flex; flex-direction: column; border-top: 1px solid var(--ink)">
        {RANGE.map((r) => (
          <div style="display: flex; justify-content: space-between; gap: 12px; padding: 14px 0; border-bottom: 1px solid #C9C5BD"><span style="font-weight: 600">{r.title}</span><span class="mono" style="font-size: 12px; color: var(--ink-2)">{r.when}</span></div>
        ))}
        <a href="/engineering/" class="mono" style="margin-top: 18px; font-size: 13px; text-transform: uppercase">Read the engineering page →</a>
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap" style="padding-block: 104px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 32px">
      <div>
        <span class="eyebrow">§ Contact</span>
        <h2 style="margin: 16px 0 0; font-size: clamp(40px, 5vw, 76px); line-height: .98; letter-spacing: -.035em; max-width: 820px">Have a problem that needs a system?</h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a class="btn btn-orange" href="/contact/">Start a conversation →</a>
        <a class="btn btn-square" style="border-color: #5A5B62; color: var(--paper)" href={SITE.resume}>Resume ↓</a>
      </div>
    </div>
  </section>
</Base>
