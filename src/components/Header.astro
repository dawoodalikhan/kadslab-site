---
import { NAV } from '../data/site';
interface Props { path: string }
const { path } = Astro.props;
---
<header class="site-header">
  <nav class="wrap site-nav" aria-label="Primary">
    <a class="brand" href="/" aria-label="KADS Lab home">
      <span class="brand-mark">KADS<span> Lab</span></span>
      <span class="brand-by">by Dawood Ali Khan</span>
    </a>
    <ul class="nav-links">
      {NAV.map((item) => (
        <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a class="btn btn-blue" style="padding: 12px 20px; font-size: 15px" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Let's talk</a>
  </nav>
</header>
