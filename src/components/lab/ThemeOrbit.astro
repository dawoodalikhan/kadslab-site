---
// Theme switcher: a planet with an orbiting moon. In dark mode the planet is a
// crescent; in light mode it becomes a sun and the moon swings to the far side.
// Plain JS, no React: a single button doesn't justify shipping a framework.
---
<button type="button" class="orbit-toggle" data-orbit-toggle aria-label="Switch to light theme">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <defs>
      <mask id="orbit-crescent">
        <rect width="32" height="32" fill="#fff" />
        <circle class="orbit-bite" cx="20" cy="12" r="6.2" fill="#000" />
      </mask>
    </defs>
    <circle class="orbit-ring" cx="16" cy="16" r="13" />
    <g class="orbit-rays">
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
        <line x1="16" y1="5.6" x2="16" y2="7.4" transform={`rotate(${a} 16 16)`} />
      ))}
    </g>
    <circle class="orbit-planet" cx="16" cy="16" r="6.5" mask="url(#orbit-crescent)" />
    <g class="orbit-moon"><circle cx="16" cy="3" r="2.2" /></g>
  </svg>
  <span class="orbit-label" data-orbit-label>dark</span>
</button>

<script>
  const KEY = 'kads-lab-theme';
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  type Theme = 'light' | 'dark';

  const current = (): Theme => (root.dataset.labTheme === 'light' ? 'light' : 'dark');

  function paint(t: Theme) {
    root.dataset.labTheme = t;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'dark' ? '#11131A' : '#F7F5F0');
    document.querySelectorAll<HTMLButtonElement>('[data-orbit-toggle]').forEach((b) => {
      b.setAttribute('aria-label', `Switch to ${t === 'dark' ? 'light' : 'dark'} theme`);
      b.querySelector('[data-orbit-label]')!.textContent = t;
    });
  }

  // Theme change: a circular reveal that grows from the switcher (View Transitions
  // API). Browsers without it, and visitors who prefer reduced motion, get an
  // instant switch.
  function apply(t: Theme, from?: HTMLElement) {
    if (!document.startViewTransition || reduce.matches || !from) return paint(t);
    const r = from.getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    root.style.setProperty('--vt-x', `${x}px`);
    root.style.setProperty('--vt-y', `${y}px`);
    root.style.setProperty('--vt-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
    document.startViewTransition(() => paint(t));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-orbit-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem(KEY, next); } catch {}
      apply(next, b);
    }),
  );

  paint(current());
</script>
